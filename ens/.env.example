# Sepolia RPC (publicnode works without a key)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Label for <label>.eth. Fallbacks that were free on 2026-09-25: otcdesk quotedesk aquadesk deskdao treasurydesk walletdesk
DESK_LABEL=dao-treasury-a
# Testnet-only keys. `npm run keys` fills these; never reuse them anywhere else.
TREASURY_PK=
AGENT_PK=
MM_A_PK=
MM_B_PK=
MM_C_PK=
# Addresses of the Aqua lane's bot wallets. When set, mm-a / mm-b point at them instead of the keys above.
MM_A_ADDRESS=
MM_B_ADDRESS=
# Address of the Aqua lane's risk agent. When set, 04-agent delegates desk.spread and desk.stats to it (no key needed);
# changing the recorded agent needs `npm run agent -- --switch`, which revokes the old one.
AGENT_ADDRESS=
